# Clover — one merchant account per physical location (see settings.LOCATIONS).
# Sandbox Platform API: https://apisandbox.dev.clover.com
# North America production Platform API: https://api.clover.com
CLOVER_BASE_URL=https://api.clover.com
# Use Clover's 13-character alphanumeric merchantId / mId, not the numeric processor MID.
CLOVER_MERCHANT_ID_MEADOWVALE=YOUR_MERCHANT_ID
CLOVER_API_TOKEN_MEADOWVALE=YOUR_API_TOKEN
CLOVER_MERCHANT_ID_HARBORVIEW=YOUR_MERCHANT_ID
CLOVER_API_TOKEN_HARBORVIEW=YOUR_API_TOKEN
# A location with no credentials (still YOUR_MERCHANT_ID/YOUR_API_TOKEN) is skipped by
# run_full_sync with a warning, not a hard failure — the other location keeps syncing.

# Database
DB_PATH=./db/anara.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname  # future: Postgres migration path

# Anthropic — narrates the analytics JSON, never calculates it. Leave as the placeholder
# below and every report still renders in full; it just skips the narrative section.
ANTHROPIC_API_KEY=YOUR_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Which analytics modules reach the report — LLM narrative AND the "By the numbers" block.
# all (default) | whitelist: revenue,inventory | subtract: -operational,-size_curve
# Known modules: revenue, inventory, size_curve, sell_through, anomalies, operational, calendar, margin
REPORT_MODULES=all

# Email — currently Resend; POSTMARK_SERVER_TOKEN / SMTP_* are reserved for future providers.
EMAIL_PROVIDER=resend
RESEND_API_KEY=YOUR_API_KEY
# POSTMARK_SERVER_TOKEN=YOUR_TOKEN
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

EMAIL_FROM=reports@anaraapparel.com
EMAIL_FROM_NAME=Anara Insights
EMAIL_TO=OWNER_EMAIL         # comma-separated for multiple recipients

# App
APP_ENV=development
BUSINESS_ID=anara-apparel-001
STORE_TIMEZONE=America/Toronto
LOG_LEVEL=INFO
